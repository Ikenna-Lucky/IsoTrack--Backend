# Reference only. Set these on the NEW Render preview service, not the live one.
NODE_ENV=production
DEPLOYMENT_ENV=preview
# RELEASE_SHA is supplied by the Docker entrypoint from its build identity.
NOTIFICATION_WORKERS_ENABLED=false
RETENTION_ENABLED=false
APP_URL=https://YOUR-PREVIEW-SERVICE.onrender.com
FRONTEND_URL=https://YOUR-PREVIEW-SERVICE.onrender.com
PREVIEW_APP_HOST=YOUR-PREVIEW-SERVICE.onrender.com
LIVE_APP_HOST=YOUR-LIVE-SERVICE.onrender.com
DATABASE_URL=postgresql://PREVIEW_USER:PREVIEW_PASSWORD@PREVIEW_NEON_HOST/PREVIEW_DB?sslmode=require
PREVIEW_DATABASE_HOST=PREVIEW_NEON_HOST
LIVE_DATABASE_HOST=LIVE_NEON_HOST
UPSTASH_REDIS_URL=rediss://default:PREVIEW_PASSWORD@PREVIEW_REDIS_HOST:6379
PREVIEW_REDIS_HOST=PREVIEW_REDIS_HOST
LIVE_REDIS_HOST=LIVE_REDIS_HOST
JWT_SECRET=GENERATE_A_NEW_RANDOM_PREVIEW_SECRET
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_RANDOM_PREVIEW_SECRET
TRUSTED_PROXY_IPS=
# SMTP credentials are deliberately inert; workers must remain disabled.
GMAIL_USER=preview@example.invalid
GMAIL_APP_PASSWORD=disabled-preview-only
ACCOUNT_ACTION_SECRET=
DELIVERY_CODE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
METRICS_TOKEN=
