# ─── App ─────────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Blank for direct connections. Exact immediate proxy IPs only; proxy must
# overwrite X-Real-IP with one verified client IP and block direct bypass.
TRUSTED_PROXY_IPS=

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/isotrack?sslmode=require

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
# Independent 32-byte hex key for durable recovery/verification email links.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ACCOUNT_ACTION_SECRET=

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
# Also backs shared API budgets. Protected shipment/payment/tracking requests
# return 503 while Redis is unavailable. Use the same database and JWT_SECRET
# across API replicas; configure trusted proxy headers before hosted rollout.
UPSTASH_REDIS_URL=rediss://default:xxxx@xxxx.upstash.io:6379

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Use a Gmail App Password — NOT your real password.
# Enable at: myaccount.google.com → Security → 2-Step Verification → App Passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=IsoTrack <you@gmail.com>

# ─── SMS (Twilio) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Stripe-hosted Checkout: backend API key and endpoint signing secret.
# Public portfolio deployments stay sandbox-only. Live keys are rejected.
# Select sandbox and provide BOTH secrets to enable payments/reconciliation.
# No publishable key is required by this flow.
STRIPE_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Private Prometheus scraping. Blank disables /metrics. Generate a random value
# independently of JWT and provider keys; 32–128 URL-safe characters.
METRICS_TOKEN=
# Delivery confirmation: independent random 32-byte key, encoded as 64 hex characters.
# Blank disables issuance/confirmation; ordinary status updates cannot bypass proof.
DELIVERY_CODE_SECRET=

# Automatic bounded cleanup. Enable deliberately after migration and preview.
RETENTION_ENABLED=false
