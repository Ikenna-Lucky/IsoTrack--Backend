# App
PORT=8000
NODE_ENV=development
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Blank for direct connections. Exact immediate proxy IPs only; proxy must
# overwrite X-Real-IP with one verified client IP and block direct bypass.
TRUSTED_PROXY_IPS=

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/isotrack?sslmode=require
# Hosted default. Local Docker setup selects postgres and enforces loopback only.
DATABASE_DRIVER=neon

# Auth (JWT)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
# Independent 32-byte hex key for durable recovery/verification email links.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ACCOUNT_ACTION_SECRET=

# Redis (Upstash)
# Shared API budgets also use Redis; protected routes return 503 if it is down.
# API replicas must share the database, Redis and JWT_SECRET.
UPSTASH_REDIS_URL=rediss://default:xxxx@xxxx.upstash.io:6379

# Email: personal Outlook mailbox, Microsoft Graph HTTPS API. No SMTP/password.
# Register a public client supporting personal Microsoft accounts with Mail.Send.
# Apply migration 0019, then run bun run email:authorize with workers disabled.
NOTIFICATION_WORKERS_ENABLED=false
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_SENDER=
# Independent random 32-byte hex key; keep stable and protect with DB backups.
MICROSOFT_MAIL_CACHE_KEY=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Stripe Checkout: sandbox mode needs a test key and matching webhook secret.
# Live keys are rejected. This flow does not need a publishable key.
STRIPE_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Private Prometheus scraping. Blank disables /metrics. Generate a random value
# independently of JWT and provider keys; 32–128 URL-safe characters.
METRICS_TOKEN=
# Delivery confirmation: independent random 32-byte key, encoded as 64 hex characters.
# Blank disables issuance/confirmation; ordinary status updates cannot bypass proof.
DELIVERY_CODE_SECRET=

# Enable cleanup after applying migrations and reviewing retention rules.
RETENTION_ENABLED=false
