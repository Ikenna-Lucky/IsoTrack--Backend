{
  "name": "isotrack-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "local:setup": "node scripts/local-setup.mjs",
    "local:up": "docker compose -f compose.local.yml --env-file .env.docker.local up -d --wait",
    "local:stop": "docker compose -f compose.local.yml --env-file .env.docker.local stop",
    "local:status": "docker compose -f compose.local.yml --env-file .env.docker.local ps",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun && node scripts/swagger-assets.mjs",
    "docs:generate": "node scripts/export-openapi.mjs",
    "docs:check": "node scripts/export-openapi.mjs --check",
    "docs:serve": "node scripts/serve-api-docs.mjs",
    "type-check": "tsc --noEmit",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:load": "node scripts/load-test.mjs",
    "test:load:hosted": "node scripts/hosted-load.mjs",
    "diagnose:preview": "node scripts/hosted-diagnostics.mjs",
    "recovery:drill": "node scripts/run-tests.mjs recovery",
    "recovery:smoke": "node scripts/recovery-smoke.mjs",
    "delivery:status": "bun run src/db/delivery-operations.ts status",
    "delivery:purge": "bun run src/db/delivery-operations.ts purge",
    "lint": "eslint src tests scripts eslint.config.mjs --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "sessions:purge": "bun run src/db/purge-sessions.ts",
    "retention:preview": "bun run src/db/retention-operations.ts preview",
    "retention:status": "bun run src/db/retention-operations.ts status",
    "retention:run": "bun run src/db/retention-operations.ts run",
    "notifications:status": "bun run src/db/notification-operations.ts status",
    "notifications:replay": "bun run src/db/notification-operations.ts replay",
    "notifications:purge": "bun run src/db/notification-operations.ts purge",
    "idempotency:scrub": "bun run src/db/scrub-idempotency.ts",
    "payments:status": "bun run src/db/payment-operations.ts status",
    "payments:reconcile": "bun run src/db/payment-operations.ts reconcile",
    "payments:attach": "bun run src/db/payment-operations.ts attach",
    "payments:record-refund": "bun run src/db/payment-operations.ts record-refund",
    "account-actions:status": "bun run src/db/account-action-operations.ts status",
    "account-actions:purge": "bun run src/db/account-action-operations.ts purge",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "email:authorize": "bun run scripts/authorize-outlook.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.2",
    "@hono/node-server": "^1.14.1",
    "@hono/zod-validator": "^0.4.3",
    "@neondatabase/serverless": "^0.10.4",
    "@prometheus-io/client": "0.16.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.54.2",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.42.0",
    "hono": "^4.7.7",
    "ioredis": "^5.6.1",
    "jose": "^5.10.0",
    "nanoid": "^5.1.5",
    "pg": "8.23.1",
    "socket.io": "^4.8.1",
    "stripe": "^23.1.0",
    "swagger-ui-dist": "^5.34.1",
    "twilio": "^5.7.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "9.39.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.2.12",
    "@types/pg": "8.11.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.26.0",
    "globals": "17.4.0",
    "openapi-types": "^12.1.3",
    "socket.io-client": "4.8.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.72.1"
  }
}
